---
// Erro da tela de avisos: a primeira linha como frase e as linhas "  - motivo" (bloqueios) como lista.
// Recebe só mensagem de ErroAviso ou genérica (src/lib/mesa.ts, mensagemDoErro). Texto escapado, sem set:html.
interface Props {
  mensagem: string;
}

const linhas = Astro.props.mensagem.split('\n').filter((l) => l.trim());
const motivos = linhas.filter((l) => /^\s*-\s/.test(l)).map((l) => l.replace(/^\s*-\s/, ''));
const frases = linhas.filter((l) => !/^\s*-\s/.test(l));
---
<div class="mesa-erro" role="alert">
  {frases.map((f) => <p>{f === 'Bloqueado:' ? 'Este aviso está bloqueado:' : f}</p>)}
  {motivos.length > 0 && <ul>{motivos.map((m) => <li>{m}</li>)}</ul>}
</div>

<style>
  .mesa-erro { padding: 14px 16px; margin-bottom: 24px; border-radius: 4px; background: #FBEDED; color: #A32222; font-weight: 600; line-height: 1.45; }
  .mesa-erro ul { margin: 8px 0 0; padding-left: 20px; font-weight: 500; }
</style>
