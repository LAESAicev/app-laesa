---
// Ícones 24px, traço 2 (estilo Lucide). Os SVGs ficam em src/icons/ e são os mesmos do Figma (Componentes → Ícones).
const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });

export type IconName = 'alert' | 'arrow' | 'calendar' | 'check' | 'chevron' | 'doc' | 'github' | 'instagram' | 'linkedin' | 'mail' | 'menu' | 'plus';

interface Props {
  name: IconName;
  /** Texto para leitores de tela; sem ele o ícone é decorativo. */
  label?: string;
}

const { name, label } = Astro.props;
const raw = icons[`../icons/${name}.svg`];
if (!raw) throw new Error(`Ícone desconhecido: ${name}`);
// O SVG entra por set:html (sem escape automático): o rótulo precisa ser escapado à mão.
const escapar = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const a11y = label ? `role="img" aria-label="${escapar(label)}"` : 'aria-hidden="true" focusable="false"';
const svg = raw.replace('<svg ', `<svg ${a11y} `);
---
<Fragment set:html={svg} />
