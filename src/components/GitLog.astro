---
import type { Commit } from '../data/home';

interface Props {
  commits: Commit[];
}

const { commits } = Astro.props;
const row = 62; // altura de cada linha do log, em px (mesma do Figma)
const height = commits.length * row;
const cy = (i: number) => row / 2 + i * row;
---
<aside class="log" aria-label="Histórico da LAESA">
  <div class="log-bar"><span class="meta">laesa / main</span><span class="meta">git log --graph</span></div>
  <div class="log-rows">
    <svg class="log-graph" viewBox={`0 0 64 ${height}`} height={height} aria-hidden="true">
      <path d={`M16 ${cy(1)} V${height}`} stroke="#1DD0F8" />
      <path d={`M16 ${cy(1)} C16 ${cy(1) - 27} 40 ${cy(1) - 21} 40 ${cy(0) + 19} V${cy(0)}`} stroke="#5CEAD2" />
      <circle cx="40" cy={cy(0)} r="8" fill="#5CEAD2" />
      {commits.slice(1).map((_, i) => {
        const last = i === commits.length - 2;
        return last
          ? <circle cx="16" cy={cy(i + 1)} r="6" fill="#1DD0F8" />
          : <circle cx="16" cy={cy(i + 1)} r="6" fill="#043F63" stroke="#1DD0F8" stroke-width="2" />;
      })}
    </svg>
    <ol>
      {commits.map((c, i) => (
        <li class:list={['log-row', { 'is-head': i === 0 }]}>
          <div>
            <span class="log-msg">{i === 0 && <span class="headref">HEAD</span>}{c.mensagem}</span>
            <span class="meta"><b>{c.hash}</b>{c.meta && ` · ${c.meta}`}</span>
          </div>
        </li>
      ))}
    </ol>
  </div>
</aside>
