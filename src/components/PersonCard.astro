---
import LinkedinBtn from './LinkedinBtn.astro';
import Retrato from './Retrato.astro';
import Sample from './Sample.astro';
import type { Pessoa } from '../data/home';

interface Props {
  pessoa: Pessoa;
}

const { pessoa: p } = Astro.props;
// Com LinkedIn, nome e cargo ganham o botão à direita (no celular, abaixo do cargo). Sem ele, o card fica como sempre foi.
const Texto = p.linkedin ? 'div' : Fragment;
---
<div class:list={['person', { adv: p.orientacao }]}>
  {/* Sem foto (a pessoa não autorizou): iniciais, como na /historia. Selo só se a pessoa for de exemplo. */}
  <div class:list={['photo', { iniciais: !p.foto }]}>
    <Retrato foto={p.foto} nome={p.nome} max={800} menor={400} sizes="(max-width: 640px) 45vw, (max-width: 1100px) 28vw, 240px" />
    {!p.foto && p.exemplo && <Sample text="foto" />}
  </div>
  <Texto {...(p.linkedin ? { class: 'person-in' } : {})}>
    <div>
      <h3>{p.nome}</h3>
      <p class="role">{p.cargo}</p>
    </div>
    {p.linkedin && <LinkedinBtn href={p.linkedin} nome={p.nome} />}
  </Texto>
</div>
