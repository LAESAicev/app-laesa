---
// Campos seguem docs/contrato-contato.md. Valida com o mesmo schema do servidor e envia para POST /api/contato.
import Icon from './Icon.astro';

interface Props {
  /** id único quando houver mais de um formulário na página */
  id?: string;
}

const { id = 'contato-form' } = Astro.props;
const f = (name: string) => `${id}-${name}`;
---
<div class="contact-box" data-contact-box>
<form class="form contact-form" id={id} action="/api/contato" method="post" novalidate data-contact-form>
  <div class="err-banner" role="alert" tabindex="-1" data-banner hidden><Icon name="alert" /><span data-banner-text></span></div>
  <div class="hp" aria-hidden="true" inert>
    <label for={f('nao_preencher')}>Não preencha este campo</label>
    <input id={f('nao_preencher')} name="nao_preencher" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <noscript><p class="hint">O envio precisa de JavaScript. Sem ele, escreva para o e-mail da LAESA na página de contato.</p></noscript>
  <div class="form-row" data-identity>
    <div class="field">
      <label for={f('nome')}>Nome</label>
      <input class="input" id={f('nome')} name="nome" type="text" autocomplete="name" required minlength="2" maxlength="120" placeholder="Seu nome" />
    </div>
    <div class="field">
      <label for={f('email')}>E-mail</label>
      <input class="input" id={f('email')} name="email" type="email" autocomplete="email" required placeholder="voce@exemplo.com" />
    </div>
  </div>

  <div class="field subject">
    <label for={f('assunto')}>Sobre o que você quer falar?</label>
    <select class="select" id={f('assunto')} name="assunto" required aria-describedby={f('assunto-dica')}>
      <option value="" disabled selected>Escolha um assunto</option>
      <option value="duvida">Tenho uma dúvida</option>
      <option value="feedback">Quero dar um feedback</option>
      <option value="projeto">Quero propor um projeto</option>
      <option value="colaborar">Quero colaborar com a liga</option>
    </select>
    <p class="hint" id={f('assunto-dica')} data-subject-hint>Ao escolher, aparecem os campos certos para o seu assunto.</p>
  </div>

  <fieldset class="cond-set" data-for="feedback" hidden disabled>
    <legend class="sr-only">campos para feedback</legend>
    <div class="cond">
    <span class="cond-label" aria-hidden="true">campos para feedback</span>
    <div class="field">
      <label for={f('atividade')}>Sobre qual atividade? <span>(opcional)</span></label>
      <select class="select" id={f('atividade')} name="atividade">
        <option value="">Escolha, se quiser</option>
        <option value="evento">Evento</option>
        <option value="oficina">Oficina</option>
        <option value="processo-seletivo">Processo seletivo</option>
        <option value="site">Site</option>
        <option value="outro">Outro</option>
      </select>
    </div>
    <label class="check">
      <input type="checkbox" name="anonimo" value="true" data-anonimo />
      <span class="box" aria-hidden="true"></span>
      <span>Enviar sem me identificar<small>Se marcar, não teremos como responder.</small></span>
    </label>
    </div>
  </fieldset>

  <fieldset class="cond-set" data-for="projeto" hidden disabled>
    <legend class="sr-only">campos para propostas de projeto</legend>
    <div class="cond">
    <span class="cond-label" aria-hidden="true">campos para propostas de projeto</span>
    <div class="form-row">
      <div class="field">
        <label for={f('organizacao')}>Organização</label>
        <input class="input" id={f('organizacao')} name="organizacao" type="text" autocomplete="organization" required minlength="2" maxlength="160" />
      </div>
      <div class="field">
        <label for={f('tipoProjeto')}>Tipo de projeto</label>
        <select class="select" id={f('tipoProjeto')} name="tipoProjeto" required>
          <option value="" disabled selected>Escolha</option>
          <option value="sistema-web">Sistema web</option>
          <option value="aplicativo">Aplicativo</option>
          <option value="pesquisa">Pesquisa</option>
          <option value="oficina-curso">Oficina ou curso</option>
          <option value="outro">Outro</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label for={f('prazo')}>Prazo desejado <span>(opcional)</span></label>
      <select class="select" id={f('prazo')} name="prazo">
        <option value="">Sem prazo definido</option>
        <option value="Este semestre">Este semestre</option>
        <option value="Próximo semestre">Próximo semestre</option>
        <option value="Ainda este ano">Ainda este ano</option>
      </select>
    </div>
    </div>
  </fieldset>

  <fieldset class="cond-set" data-for="colaborar" hidden disabled>
    <legend class="sr-only">campos para colaboradores</legend>
    <div class="cond">
    <span class="cond-label" aria-hidden="true">campos para colaboradores</span>
    <div class="form-row">
      <div class="field">
        <label for={f('formaColaboracao')}>Como quer colaborar?</label>
        <select class="select" id={f('formaColaboracao')} name="formaColaboracao" required>
          <option value="" disabled selected>Escolha</option>
          <option value="palestra">Palestra</option>
          <option value="mentoria">Mentoria</option>
          <option value="oficina">Oficina</option>
          <option value="apoio-evento">Apoio em evento</option>
          <option value="outro">Outro</option>
        </select>
      </div>
      <div class="field">
        <label for={f('area')}>Área de atuação</label>
        <input class="input" id={f('area')} name="area" type="text" required minlength="2" maxlength="120" />
      </div>
    </div>
    <div class="field">
      <label for={f('link')}>LinkedIn ou portfólio <span>(opcional)</span></label>
      <input class="input" id={f('link')} name="link" type="url" inputmode="url" placeholder="https://" />
    </div>
    </div>
  </fieldset>

  <div class="field">
    <label for={f('mensagem')} data-message-label>Mensagem</label>
    <textarea class="textarea" id={f('mensagem')} name="mensagem" required minlength="10" maxlength="4000" placeholder="Escreva aqui"></textarea>
  </div>

  <div class="form-foot">
    <p class="hint" data-foot-hint>Usamos seus dados só para responder esta mensagem. <a class="link-inline" href="/privacidade">Privacidade</a></p>
    <button class="btn btn-primary" type="submit"><span data-submit-label>Enviar mensagem</span><Icon name="arrow" /></button>
  </div>
</form>
<div class="form success" tabindex="-1" aria-labelledby={`${id}-ok`} data-success hidden>
  <div class="ok-graph" aria-hidden="true">
    <svg viewBox="0 0 40 160" width="40" height="160" fill="none">
      <path d="M20 0 V160" stroke="#B4C6D6" stroke-width="2" />
      <circle cx="20" cy="36" r="9" fill="#5CEAD2" />
      <circle cx="20" cy="36" r="15" stroke="#5CEAD2" stroke-opacity="0.35" stroke-width="4" />
      <circle cx="20" cy="120" r="6" fill="#FFFFFF" style="stroke: var(--blue)" stroke-width="2" />
    </svg>
  </div>
  <div class="ok-body">
    <span class="headref">nova mensagem</span>
    <h3 class="d3" id={`${id}-ok`}>Mensagem enviada.</h3>
    <p class="body" data-success-text></p>
    <span class="meta" data-success-meta></span>
    <button class="btn btn-outline" type="button" data-again>Enviar outra mensagem</button>
  </div>
</div>
</div>

<script>
  import type { Assunto } from '../lib/contato.schema';
  import { formParaObjeto, type Erros } from '../lib/formulario';

  // O schema traz o zod (~24 KB gzip): só baixa quando a pessoa começa a preencher ou envia.
  type Schema = typeof import('../lib/contato.schema');
  let schema: Promise<Schema> | undefined;
  const carregarSchema = () =>
    (schema ??= import('../lib/contato.schema').catch((e) => {
      schema = undefined; // falhou (rede): a próxima tentativa baixa de novo
      throw e;
    }));
  const SEM_CONEXAO = 'Sem conexão com o servidor. Confira sua internet e tente de novo.';

  const ALERT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>';
  const SPIN = '<svg class="spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="rgba(255,255,255,0.3)" stroke-width="2.5"/><path d="M21 12a9 9 0 0 0-9-9" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>';

  function descrever(el: Element, id: string, on: boolean) {
    const ids = new Set((el.getAttribute('aria-describedby') ?? '').split(' ').filter(Boolean));
    if (on) ids.add(id);
    else ids.delete(id);
    if (ids.size) el.setAttribute('aria-describedby', [...ids].join(' '));
    else el.removeAttribute('aria-describedby');
  }

  function limparCampo(input: HTMLElement) {
    const field = input.closest('.field');
    field?.classList.remove('is-error');
    field?.querySelector('[data-err]')?.remove();
    input.removeAttribute('aria-invalid');
    descrever(input, `${input.id}-erro`, false);
  }

  function limparErros(form: HTMLFormElement) {
    form.querySelectorAll<HTMLElement>('[aria-invalid]').forEach(limparCampo);
    form.querySelectorAll('[data-err]').forEach((el) => el.remove());
    form.querySelectorAll('.field.is-error').forEach((f) => f.classList.remove('is-error'));
    form.querySelector<HTMLElement>('[data-banner]')!.hidden = true;
  }

  const visivel = (el: HTMLElement) => (el as HTMLInputElement).disabled !== true && !el.closest('[hidden], fieldset:disabled');

  function mostrarErros(form: HTMLFormElement, erros: Erros, banner?: string) {
    limparErros(form);
    let primeiro: HTMLElement | null = null;
    let total = 0;
    for (const [campo, msg] of Object.entries(erros)) {
      if (!msg) continue;
      const input = [...form.querySelectorAll<HTMLElement>(`[name="${CSS.escape(campo)}"]`)].find(visivel);
      const field = input?.closest('.field');
      if (!input || !field) continue;
      total += 1;
      field.classList.add('is-error');
      input.setAttribute('aria-invalid', 'true');
      const p = document.createElement('p');
      p.className = 'err';
      p.dataset.err = '';
      p.id = `${input.id}-erro`;
      p.innerHTML = ALERT;
      p.append(msg);
      descrever(input, p.id, true);
      field.append(p);
      primeiro ??= input;
    }
    const texto = banner ?? (total === 1 ? 'Revise 1 campo para enviar a mensagem.' : `Revise ${total} campos para enviar a mensagem.`);
    if (banner || total > 0) {
      const b = form.querySelector<HTMLElement>('[data-banner]')!;
      const t = b.querySelector('[data-banner-text]')!;
      t.textContent = '';
      b.hidden = false;
      requestAnimationFrame(() => (t.textContent = texto)); // reanuncia mesmo se o texto for igual ao anterior
      if (!primeiro) b.focus(); // erro de rede/servidor: sem campo para focar
    }
    primeiro?.focus();
  }

  function enviando(form: HTMLFormElement, on: boolean) {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.classList.toggle('is-sending', on);
    form.inert = on; // nada muda (assunto, campos) enquanto envia
    btn.disabled = on;
    btn.classList.toggle('is-loading', on);
    btn.setAttribute('aria-busy', String(on));
    if (on) {
      btn.dataset.html = btn.innerHTML;
      btn.innerHTML = `${SPIN} Enviando`;
    } else if (btn.dataset.html) {
      btn.innerHTML = btn.dataset.html;
    }
  }

  function sucesso(form: HTMLFormElement, dados: { assunto: Assunto; email?: string; anonimo?: boolean }, rotulo: string) {
    const box = form.closest<HTMLElement>('[data-contact-box]')!;
    const ok = box.querySelector<HTMLElement>('[data-success]')!;
    const texto = ok.querySelector<HTMLElement>('[data-success-text]')!;
    const recebemos = { duvida: 'sua dúvida', feedback: 'seu feedback', projeto: 'sua proposta de projeto', colaborar: 'sua mensagem' }[dados.assunto];
    texto.replaceChildren(
      dados.anonimo || !dados.email
        ? `Recebemos ${recebemos}. Obrigado! Como foi enviado sem identificação, não há resposta.`
        : `Recebemos ${recebemos}. A resposta da Mesa Diretora chega no e-mail `,
    );
    if (!dados.anonimo && dados.email) {
      const b = document.createElement('b');
      b.textContent = dados.email;
      texto.append(b, '.');
    }
    ok.querySelector('[data-success-meta]')!.textContent = `assunto: ${rotulo.toLowerCase()}`;
    form.hidden = true;
    ok.hidden = false;
    ok.focus();
  }

  async function enviarFormulario(form: HTMLFormElement) {
    const obj = formParaObjeto(new FormData(form));
    const { nao_preencher: _hp, ...paraValidar } = obj;
    let s: Schema;
    try {
      s = await carregarSchema();
    } catch {
      return mostrarErros(form, {}, SEM_CONEXAO);
    }
    const r = s.validarContato(paraValidar);
    if (!r.ok) return mostrarErros(form, r.erros);
    limparErros(form);
    enviando(form, true);
    let res: Response | undefined;
    let body: { erro?: string; erros?: Erros } = {};
    try {
      res = await fetch(form.action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(obj) });
      body = await res.json().catch(() => ({}));
    } catch {
      res = undefined;
    } finally {
      enviando(form, false); // destrava antes de mostrar o resultado: elemento inert não recebe foco
    }
    if (!res) return mostrarErros(form, {}, SEM_CONEXAO);
    if (res.status === 201) return sucesso(form, r.data, s.rotuloAssunto[r.data.assunto]);
    if (res.status === 422 && body.erros) return mostrarErros(form, body.erros);
    mostrarErros(form, {}, body.erro ?? 'Não foi possível enviar agora. Tente de novo em instantes.');
  }

  for (const again of document.querySelectorAll<HTMLButtonElement>('[data-again]')) {
    again.addEventListener('click', () => {
      const box = again.closest<HTMLElement>('[data-contact-box]')!;
      const form = box.querySelector<HTMLFormElement>('form')!;
      form.reset();
      form.dispatchEvent(new Event('laesa:reset'));
      box.querySelector<HTMLElement>('[data-success]')!.hidden = true;
      form.hidden = false;
      limparErros(form);
      form.querySelector<HTMLElement>('select[name="assunto"]')?.focus();
    });
  }

  const padrao = { message: 'Mensagem', submit: 'Enviar mensagem', hint: 'Usamos seus dados só para responder esta mensagem.' };
  const copy: Record<Assunto, { message: string; submit: string; hint: string }> = {
    duvida: { message: 'Sua dúvida', submit: 'Enviar mensagem', hint: 'Usamos seus dados só para responder esta mensagem.' },
    feedback: { message: 'Seu feedback', submit: 'Enviar feedback', hint: 'Usamos seus dados só para responder esta mensagem.' },
    projeto: { message: 'Conte o problema que você quer resolver', submit: 'Enviar proposta', hint: 'A LAESA é sem fins lucrativos. Propostas são avaliadas pela Mesa Diretora conforme o cronograma e a disponibilidade dos Squads.' },
    colaborar: { message: 'Mensagem', submit: 'Enviar mensagem', hint: 'Colaboradores podem receber certificado conforme a atividade e a carga horária.' },
  };

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    const select = form.querySelector<HTMLSelectElement>('select[name="assunto"]')!;
    const identity = form.querySelector<HTMLElement>('[data-identity]')!;
    const anonimo = form.querySelector<HTMLInputElement>('[data-anonimo]')!;

    const syncIdentity = () => {
      const anon = select.value === 'feedback' && anonimo.checked;
      identity.hidden = anon;
      identity.querySelectorAll('input').forEach((i) => (i.disabled = anon));
    };

    const apply = (value: string) => {
      form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-for]').forEach((fs) => {
        const on = fs.dataset.for === value;
        fs.hidden = !on;
        fs.disabled = !on; // campos escondidos não bloqueiam a validação nem são enviados
      });
      const c = copy[value as Assunto] ?? padrao;
      form.querySelector('[data-message-label]')!.textContent = c.message;
      const submit = form.querySelector('[data-submit-label]');
      if (submit) submit.textContent = c.submit;
      form.querySelector('[data-foot-hint]')!.firstChild!.textContent = `${c.hint} `;
      form.querySelector<HTMLElement>('[data-subject-hint]')!.hidden = Object.hasOwn(copy, value);
      syncIdentity();
    };

    select.addEventListener('change', () => {
      limparErros(form); // erros de outro assunto não fazem mais sentido
      apply(select.value);
    });
    form.addEventListener('laesa:reset', () => apply(''));
    anonimo.addEventListener('change', () => {
      limparErros(form);
      syncIdentity();
    });
    // corrigir um campo tira o erro dele; sem erros restantes, o aviso some
    form.addEventListener('input', (e) => {
      const el = e.target as HTMLElement;
      if (el.getAttribute('aria-invalid') !== 'true') return;
      limparCampo(el);
      if (!form.querySelector('[data-err]')) form.querySelector<HTMLElement>('[data-banner]')!.hidden = true;
    });

    // /contato?assunto=projeto pré-seleciona o assunto (links do rodapé e da home)
    const pre = new URLSearchParams(location.search).get('assunto');
    if (pre && Object.hasOwn(copy, pre)) select.value = pre;
    // Sempre sincroniza com o valor atual: o "voltar" do navegador restaura o select sem disparar change.
    apply(select.value);
    window.addEventListener('pageshow', () => apply(select.value));

    form.addEventListener('focusin', () => void carregarSchema().catch(() => {}), { once: true });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void enviarFormulario(form);
    });
  }
</script>
