---
import Sample from './Sample.astro';
import type { Projeto } from '../data/home';

interface Props {
  projeto: Projeto;
}

const { projeto: p } = Astro.props;
const status = p.status === 'concluido' ? `concluído${p.ano ? ` · ${p.ano}` : ''}` : 'em andamento';
---
<article class="proj">
  <span class="proj-node" aria-hidden="true"></span>
  <div>
    <h3 class="d3">{p.link ? <a href={p.link}>{p.nome}</a> : p.nome}</h3>
    <div class="proj-tags">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
  </div>
  <p class="body">{p.descricao}</p>
  <div class="proj-status">
    <span class:list={['status', p.status === 'concluido' ? 'merged' : 'active']}><i aria-hidden="true"></i>{status}</span>
    {p.exemplo && <Sample />}
  </div>
</article>
