# Proxy e HTTPS automático (Let's Encrypt) para o site da LAESA.
# SITE_DOMAIN vem do .env (ex.: laesa.icev.edu.br). Com "localhost", o Caddy usa um certificado local.
{$SITE_DOMAIN} {
	encode zstd gzip

	# formulários: no máximo 64 KB (o app também limita)
	request_body {
		max_size 64KB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# CSP por área. O token do GitHub de quem edita no painel fica legível por JS neste mesmo domínio
	# (Keystatic), então as páginas públicas só rodam scripts do próprio site: um XSS não carrega nada de fora.
	# O build não gera script inline (astro.config.mjs: assetsInlineLimit 0).
	@site not path /keystatic /keystatic/* /api/keystatic/* /uploads/* *.svg
	header @site Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

	# Painel: fala direto com a API do GitHub, então fica só com o básico; fora dos buscadores e sem cache.
	@painel path /keystatic /keystatic/* /api/keystatic/*
	header @painel Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	header @painel X-Robots-Tag "noindex, nofollow"
	header @painel Cache-Control "no-store"

	# Arquivos enviados pelo painel (PDFs, SVGs): abertos em sandbox, sem rodar script no domínio do site.
	@uploads path /uploads/* *.svg
	header @uploads Content-Security-Policy "sandbox; default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'"

	# HSTS só no domínio real (sem preload: o domínio é do iCEV)
	@publico not host localhost
	header @publico Strict-Transport-Security "max-age=31536000"

	# O app confia em X-Forwarded-For (TRUST_PROXY=1) porque aqui ele é SOBRESCRITO com o IP real
	# do visitante; um valor forjado pelo cliente nunca chega ao app. Se o iCEV tiver um proxy/NAT na frente
	# deste Caddy, {remote_host} vira o IP dele: configure trusted_proxies com o IP desse proxy.
	reverse_proxy app:4321 {
		header_up X-Forwarded-For {remote_host}
	}

	# Sem log de acesso de propósito: as URLs de confirmação/descadastro carregam e-mails em tokens.
}
