# Copie para .env e preencha. Nunca commite o .env.
# PUBLIC_* e SITE_URL: Variables do GitHub (entram no build da imagem). Segredos: só no .env do servidor.

# Endereço público do site (domínio do iCEV, pendente). Usado em links canônicos.
SITE_URL=https://laesa.icev.edu.br

# Contato e redes exibidos no site (rodapé, página de contato). Deixe vazio para esconder uma rede.
PUBLIC_CONTACT_EMAIL=laesa@somosicev.com
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/laesaicev
PUBLIC_GITHUB_URL=https://github.com/LAESAicev
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/laesa.icev

# ---- Envio de e-mail (formulário de contato e avisos) — SEGREDOS, só no servidor
# Padrão: Mailpit na sua máquina, que mostra numa página os e-mails em vez de enviar (mesmo comando do README):
#   docker run -d --name laesa-mailpit -p 8025:8025 -p 1025:1025 \
#     -e MP_SMTP_AUTH_ACCEPT_ANY=1 -e MP_SMTP_AUTH_ALLOW_INSECURE=1 axllent/mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev
# No servidor: conta Google Workspace da LAESA com verificação em duas etapas + senha de app (16 caracteres).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=laesa@somosicev.com
# SMTP_PASS=
# Caixa que recebe as mensagens do formulário (padrão: PUBLIC_CONTACT_EMAIL)
# MAIL_TO=laesa@somosicev.com

# SMTP que não seja local só é usado com NODE_ENV=production no processo (a imagem Docker já define).
# `npm run dev`, `npm run preview` e `node dist/server/entry.mjs` na sua máquina recusam. Só ligue para
# testar um envio real de propósito, e apague a linha depois.
# ENVIO_REAL=false

# ---- Inscrição em avisos
# Gere com: openssl rand -hex 32
INSCRICAO_SECRET=
# Armazenamento dos inscritos: "sqlite" (o compose já define, arquivo no volume /data) ou "memoria" (dev/testes).
# INSCRITOS_STORE=memoria

# ---- Painel de conteúdo (/keystatic)
# Vazio: painel só em `npm run dev`, editando os arquivos da máquina (modo local).
# Preenchido: modo GitHub. Login com a conta do GitHub, e só salva quem tem escrita no repositório. O painel
# passa a existir também no site publicado. Passo a passo em docs/operacao.md ("Painel em produção").
# PUBLIC_KEYSTATIC_GITHUB_REPO=LAESAicev/app-laesa
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Credenciais do GitHub App — SEGREDOS, só no servidor (o painel cria estes valores ao criar o App)
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=

# ---- Deploy com Docker (compose.yaml)
# Domínio que o Caddy atende e para o qual emite o certificado HTTPS
SITE_DOMAIN=laesa.icev.edu.br
# Imagem a usar (o CI publica no GitHub Container Registry)
# IMAGE=ghcr.io/laesaicev/app-laesa:latest
# TRUST_PROXY: o compose já define 1 (o Caddy sobrescreve X-Forwarded-For). Fora do compose, só use 1 atrás
# de um proxy que faça o mesmo e com o contêiner sem porta exposta.
