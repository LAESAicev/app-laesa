# Copie para .env e preencha. Nunca commite o .env.
# No deploy (Fase 5), estas variáveis vêm dos segredos/variáveis do GitHub Actions ou do servidor.

# Endereço público do site (domínio do iCEV, pendente). Usado em links canônicos.
SITE_URL=https://laesa.icev.edu.br

# Contato e redes exibidos no site (rodapé, página de contato). Deixe vazio para esconder uma rede.
PUBLIC_CONTACT_EMAIL=laesa@somosicev.com
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/laesaicev
PUBLIC_GITHUB_URL=https://github.com/LAESAicev
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/laesa.icev

# ---- Envio de e-mail (formulário de contato e avisos) — SEGREDOS, só no servidor
# Conta Google Workspace da LAESA com verificação em duas etapas + senha de app (16 caracteres).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=laesa@somosicev.com
SMTP_PASS=
# Caixa que recebe as mensagens do formulário (padrão: PUBLIC_CONTACT_EMAIL)
# MAIL_TO=laesa@somosicev.com

# Desenvolvimento com Mailpit (docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=dev
# SMTP_PASS=dev

# ---- Inscrição em avisos
# Gere com: openssl rand -hex 32
INSCRICAO_SECRET=
# Armazenamento dos inscritos: pendente (ADR 0001, P2). "memoria" só para desenvolvimento/testes.
# INSCRITOS_STORE=memoria

# ---- Proxy (Fase 5): 1 só quando o proxy sobrescreve X-Forwarded-For com o IP real e o contêiner não expõe porta
# TRUST_PROXY=1
